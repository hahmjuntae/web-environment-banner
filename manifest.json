{
  "manifest_version": 3,
  "name": "Web Environment Banner",
  "version": "0.1.0",
  "description": "등록한 URL에 접속하면 페이지 최상단에 로컬·개발·운영 환경 배너를 표시합니다.",
  "minimum_chrome_version": "88",
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "permissions": ["storage", "activeTab"],
  "action": {
    "default_title": "Web Environment Banner",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "assets/icon16.png",
      "32": "assets/icon32.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "src/lib/icons.js",
        "src/lib/font.js",
        "src/lib/defaults.js",
        "src/lib/match.js",
        "src/lib/store.js",
        "src/lib/banner.js",
        "src/content/content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/fonts/PretendardVariable.woff2"],
      "matches": ["<all_urls>"]
    }
  ]
}
